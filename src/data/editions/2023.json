      "id": "2023-yu-wentao-gu-yuming-hospital",
      "title": "南通市中医院智能挂号系统",
      "studentId": "yu-wentao",
      "studentName": "余文涛、顾郁铭",
      "class": "高一15班 / 高一7班",
      "award": "凭高临岳",
      "awardTier": "third",
      "category": "医疗信息化与算法",
      "tags": [
        "C++",
